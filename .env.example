# Copy to .env for local development. .env is git-ignored; chmod 600 it.
# Anything set here is resolved by arrows' DotEnvProvider.

# Which components to load at start-up (optional; otherwise call arrows.load(...))
# ARROWS_COMPONENTS=s3,redshift
# ARROWS_AUTOLOAD=1

# AWS — prefer leaving these unset and using an AWS profile or SSO instead.
# AWS_PROFILE=my-profile
# AWS_REGION=us-east-1

# S3
# ARROWS_DEFAULT_BUCKET=my-bucket

# Redshift — omit REDSHIFT_PASSWORD and set REDSHIFT_CLUSTER_IDENTIFIER to use
# short-lived IAM credentials instead of a stored password.
# REDSHIFT_HOST=my-cluster.eu-west-1.redshift.amazonaws.com
# REDSHIFT_DATABASE=dev
# REDSHIFT_USER=analyst
# REDSHIFT_PORT=5439
# REDSHIFT_CLUSTER_IDENTIFIER=my-cluster

# Google — the OAuth token document, or leave it in ~/.credentials/google_token.json
# GOOGLE_TOKEN_JSON={"refresh_token": "...", "client_id": "...", "client_secret": "..."}
